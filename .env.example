# =============================================================================
# Docker Compose - Biến môi trường
# Copy file này thành .env ở thư mục gốc (cùng cấp với docker-compose.yml)
#   cp .env.example .env
# Sau đó chỉnh giá trị thực tế trong .env (đặc biệt JWT_SECRET khi deploy).
#
# Profiles (docker-compose.yml):
#   db   — Postgres trong Docker
#   app  — backend + frontend
#   edge — nginx + keep-alive (production)
#   tunnel — cloudflared (production qua Cloudflare Tunnel, thay cho edge)
#
# Ví dụ:
#   docker compose --profile db up -d
#   docker compose --profile db --profile app up -d
#   docker compose --profile db --profile app --profile edge up -d
#   ./deploy.sh   (db + app + tunnel, one-click trên máy chủ)
# =============================================================================

# -----------------------------------------------------------------------------
# Docker - Image & build config (docker build + docker-compose)
# -----------------------------------------------------------------------------
BACKEND_IMAGE=kaopiz-ex-backend:local
FRONTEND_IMAGE=kaopiz-ex-frontend:local
NGINX_IMAGE=kaopiz-ex-nginx:local
IMAGE_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# PostgreSQL (service db)
# -----------------------------------------------------------------------------
POSTGRES_USER=kaopiz_ex
POSTGRES_PASSWORD=kaopiz_ex_secret
POSTGRES_DB=kaopiz_ex
# Port publish ra host (mặc định 127.0.0.1:5432, chỉ máy local truy cập được).
# Đổi nếu server đã có service khác dùng 5432.
# POSTGRES_PORT=5432
# POSTGRES_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# Backend (profile app)
# Mặc định compose build DATABASE_URL từ POSTGRES_* (@db:5432) khi bật profile db.
# Không dùng profile db: set DATABASE_URL trỏ Postgres ngoài (bỏ comment dòng dưới).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
APP_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD) - Cho Ksystem
# Không phải secret: là app Azure của Ksystem, hiện sẵn trong URL đăng nhập Microsoft.
# Redirect URI phải là URI đã đăng ký cho app đó (trang của Ksystem), không phải domain app này.
AZURE_CLIENT_ID=e756092c-7a97-4fa1-9cc3-cd418b1d7d63
AZURE_REDIRECT_URI=https://ksystem.kaopiz.com/auth/microsoft
AZURE_SCOPE=user.read openid profile offline_access
AZURE_AUTHORITY=https://login.microsoftonline.com/848fba98-f4e3-4c6c-9bfd-d1372c73e936

# Ksystem API
KSYSTEM_API_BASE_URL=https://ksystem.kaopiz.com/api
KSYSTEM_SOCIAL_LOGIN_ENDPOINT=https://ksystem.kaopiz.com/api/sociallogin/microsoft

# Ksystem OAuth - Cho HRM
KSYSTEM_OAUTH_BASE_URL=https://ksystem.kaopiz.com
KSYSTEM_OAUTH_CLIENT_ID=7
KSYSTEM_OAUTH_REDIRECT_URI=https://api.hrm.kaopiz.com/api/auth/callback

# HRM API
HRM_API_BASE_URL=https://api.hrm.kaopiz.com/api

# Telegram Bot (thông báo)
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Frontend (service frontend)
# URL API mà trình duyệt gọi - khi chạy Docker thường là http://localhost:8000
# (build-time: bake vào Next.js; runtime env cũng được set trong container)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Nginx + Certbot (auto setup)
# -----------------------------------------------------------------------------
PRIMARY_DOMAIN=example.com
EXTRA_DOMAINS=www.example.com
CERTBOT_EMAIL=admin@example.com
CERTBOT_STAGING=false

# Upstream services - hostname khớp với tên service trong docker-compose
# Port dùng chung với FRONTEND_PORT / BACKEND_PORT ở trên
FRONTEND_HOST=frontend
BACKEND_HOST=backend

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (profile tunnel — dùng thay cho nginx, chạy bằng ./deploy.sh)
# Để trống thì deploy.sh sẽ hỏi lúc chạy và tự lưu vào đây.
# Khi dùng tunnel, API ở subdomain riêng (cloudflared không cắt được prefix /api):
#   APP_URL=https://kaopiz-ex.example.com
#   CORS_ORIGIN=https://kaopiz-ex.example.com
#   NEXT_PUBLIC_API_BASE_URL=https://kaopiz-ex-api.example.com
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
