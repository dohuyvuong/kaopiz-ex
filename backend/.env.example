# Server Configuration
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Microsoft Entra ID (Azure AD) - Cho Ksystem
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
AZURE_SCOPE=user.read openid profile offline_access
AZURE_AUTHORITY=https://login.microsoftonline.com/your_tenant_id
AZURE_TOKEN_ENDPOINT=https://login.microsoftonline.com/your_tenant_id/oauth2/v2.0/token

# Ksystem API
KSYSTEM_API_BASE_URL=https://ksystem.kaopiz.com/api
KSYSTEM_SOCIAL_LOGIN_ENDPOINT=https://ksystem.kaopiz.com/api/sociallogin/microsoft

# Ksystem OAuth - Cho HRM
KSYSTEM_OAUTH_BASE_URL=https://ksystem.kaopiz.com
KSYSTEM_OAUTH_CLIENT_ID=7
KSYSTEM_OAUTH_REDIRECT_URI=https://api.hrm.kaopiz.com/api/auth/callback

# HRM API
HRM_API_BASE_URL=https://api.hrm.kaopiz.com
